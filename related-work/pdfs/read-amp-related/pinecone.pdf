entProperties({\\\"Publish Date\\\": \\\"2024-01-16\\\"});\"}]}],[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BlogPosting\\\",\\\"headline\\\":\\\"Reimagining the vector database to enable knowledgeable AI\\\",\\\"url\\\":\\\"https://www.pinecone.io/blog/serverless-architecture/\\\",\\\"image\\\":\\\"https://www.pinecone.io/api/og/?title=Reimagining%20the%20vector%20database%20to%20enable%20knowledgeable%20AI\u0026category=Blog\\\",\\\"datePublished\\\":\\\"2024-01-16\\\",\\\"dateModified\\\":\\\"2025-11-04T22:14:23Z\\\",\\\"mainEntityOfPage\\\":{\\\"@type\\\":\\\"WebPage\\\",\\\"@id\\\":\\\"https://www.pinecone.io/blog/serverless-architecture/\\\"},\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Pinecone\\\",\\\"logo\\\":{\\\"@type\\\":\\\"ImageObject\\\",\\\"url\\\":\\\"https://www.pinecone.io/images/pinecone-logo-thumbnail-white.png\\\"}},\\\"author\\\":[{\\\"@type\\\":\\\"Person\\\",\\\"name\\\":\\\"Ram Sriharsha\\\"}],\\\"isAccessibleForFree\\\":true}\"}}],[\"$\",\"article\",null,{\"children\":[[\"$\",\"section\",null,{\"children\":[\"$\",\"div\",null,{\"id\":\"banner\",\"children\":[\"$\",\"div\",null,{\"className\":\"border-b\",\"children\":[\"$\",\"div\",null,{\"id\":\"$undefined\",\"className\":\"container\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative px-4 sm:px-8 flex flex-col gap-8 pb-4 pt-16 md:gap-16 md:pb-8 md:pt-24 xl:flex-row\",\"children\":[[[\"$\",\"div\",null,{\"className\":\"w-full xl:w-[13.5rem]\",\"children\":[\"$\",\"$L1f\",null,{\"className\":\"text-text-secondary hover:text-text-primary border-b-border group inline-block border-b text-sm/[1] leading-none transition-colors duration-300\",\"href\":\"/blog/\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block transition-transform duration-300 group-hover:-translate-x-1 \",\"children\":\"←\"}],\" \",[\"$\",\"span\",null,{\"child